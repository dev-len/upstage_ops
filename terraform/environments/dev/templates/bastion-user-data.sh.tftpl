#!/usr/bin/env bash

set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive

if command -v apt-get >/dev/null 2>&1; then
  apt-get update -y
  apt-get install -y awscli curl
fi

install -d -m 0755 /opt/k3s-bootstrap

cat >/opt/k3s-bootstrap/connect-node.sh <<'SCRIPT'
#!/usr/bin/env bash

set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "usage: $0 <node-name> [ssh-command]" >&2
  exit 1
fi

readonly NODE_NAME="$1"
readonly REMOTE_COMMAND="$${2:-}"
readonly AWS_REGION="$${AWS_REGION:-${aws_region}}"
readonly CLUSTER_PREFIX="$${CLUSTER_PREFIX:-${cluster_prefix}}"
readonly SSH_USER="$${SSH_USER:-ubuntu}"
readonly SSH_PORT="$${SSH_PORT:-22}"
readonly SSH_IDENTITY_FILE="$${SSH_IDENTITY_FILE:-}"
readonly SSH_EXTRA_ARGS="$${SSH_EXTRA_ARGS:-}"
readonly INSTANCE_NAME_TAG="$${CLUSTER_PREFIX}-$${NODE_NAME}"

PRIVATE_IP="$(
  aws ec2 describe-instances \
    --region "$AWS_REGION" \
    --filters \
      "Name=tag:Name,Values=$${INSTANCE_NAME_TAG}" \
      "Name=instance-state-name,Values=running" \
    --query 'Reservations[].Instances[].PrivateIpAddress | [0]' \
    --output text
)"

if [[ -z "$PRIVATE_IP" || "$PRIVATE_IP" == "None" ]]; then
  echo "could not find running instance for Name tag: $${INSTANCE_NAME_TAG}" >&2
  exit 1
fi

ssh_args=()
ssh_args+=("-p" "$SSH_PORT")
if [[ -n "$SSH_IDENTITY_FILE" ]]; then
  ssh_args+=("-i" "$SSH_IDENTITY_FILE")
fi

if [[ -n "$SSH_EXTRA_ARGS" ]]; then
  # shellcheck disable=SC2206
  extra_args=( $SSH_EXTRA_ARGS )
  ssh_args+=("$${extra_args[@]}")
fi

if [[ -n "$REMOTE_COMMAND" ]]; then
  exec ssh "$${ssh_args[@]}" "$${SSH_USER}@$${PRIVATE_IP}" "$REMOTE_COMMAND"
fi

exec ssh "$${ssh_args[@]}" "$${SSH_USER}@$${PRIVATE_IP}"
SCRIPT

chmod +x /opt/k3s-bootstrap/connect-node.sh

for node_name in server app_1 app_2 metrics logs_traces db llm_obs clickhouse; do
  cat >/opt/k3s-bootstrap/${node_name}.sh <<SCRIPT
#!/usr/bin/env bash
set -euo pipefail
exec /opt/k3s-bootstrap/connect-node.sh ${node_name} "\$@"
SCRIPT
  chmod +x /opt/k3s-bootstrap/${node_name}.sh
done

cat >/etc/profile.d/k3s-bootstrap.sh <<'SCRIPT'
export AWS_REGION="${aws_region}"
export CLUSTER_PREFIX="${cluster_prefix}"
export BASTION_SSH_PORT="${bastion_ssh_port}"
alias k3s-bootstrap='cd /opt/k3s-bootstrap'
SCRIPT
