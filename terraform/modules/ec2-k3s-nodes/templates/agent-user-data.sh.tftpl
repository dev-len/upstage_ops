#!/usr/bin/env bash

set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive

if command -v apt-get >/dev/null 2>&1; then
  apt-get update -y
  apt-get install -y curl
fi

cat >/usr/local/bin/bootstrap-k3s-agent.sh <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

join_csv() {
  local csv="$1"
  local flag="$2"

  if [[ -z "$csv" ]]; then
    return
  fi

  IFS=',' read -r -a items <<< "$csv"
  for item in "${items[@]}"; do
    printf ' %s %q' "$flag" "$item"
  done
}

readonly NODE_TAINTS="$${K3S_NODE_TAINTS:-}"
readonly AGENT_ARGS="$${K3S_AGENT_ARGS:-}"
readonly INSTALL_EXEC="agent --node-name $${K3S_NODE_NAME}$$(join_csv "$K3S_NODE_LABELS" "--node-label")$$(join_csv "$NODE_TAINTS" "--node-taint") $${AGENT_ARGS}"

for _ in $(seq 1 60); do
  if curl -skf "https://$${K3S_SERVER_HOST}:6443/ping" >/dev/null 2>&1; then
    break
  fi
  sleep 10
done

curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC="$${INSTALL_EXEC}" K3S_URL="https://$${K3S_SERVER_HOST}:6443" K3S_TOKEN="$${K3S_TOKEN}" sh -
SCRIPT

chmod +x /usr/local/bin/bootstrap-k3s-agent.sh

K3S_SERVER_HOST='${k3s_server_host}' \
K3S_TOKEN='${k3s_token}' \
K3S_NODE_NAME='${k3s_node_name}' \
K3S_NODE_LABELS='${k3s_node_labels}' \
K3S_NODE_TAINTS='${k3s_node_taints}' \
K3S_AGENT_ARGS='${k3s_agent_args}' \
/usr/local/bin/bootstrap-k3s-agent.sh
