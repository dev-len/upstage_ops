#!/usr/bin/env bash

set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive

if command -v apt-get >/dev/null 2>&1; then
  apt-get update -y
  apt-get install -y curl
fi

install -d -m 0700 /home/ubuntu/.ssh
touch /home/ubuntu/.ssh/authorized_keys
chmod 0600 /home/ubuntu/.ssh/authorized_keys
chown -R ubuntu:ubuntu /home/ubuntu/.ssh

if [[ -n '${authorized_key}' ]]; then
  if ! grep -Fxq '${authorized_key}' /home/ubuntu/.ssh/authorized_keys; then
    printf '%s\n' '${authorized_key}' >> /home/ubuntu/.ssh/authorized_keys
  fi
fi

cat >/usr/local/bin/bootstrap-k3s-server.sh <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

join_csv() {
  local csv="$1"
  local flag="$2"

  if [[ -z "$csv" ]]; then
    return
  fi

  IFS=',' read -r -a items <<< "$csv"
  for item in "$${items[@]}"; do
    printf ' %s %q' "$flag" "$item"
  done
}

readonly NODE_LABELS="$${K3S_NODE_LABELS:-topology.k3s.io/role=server}"
readonly NODE_TAINTS="$${K3S_NODE_TAINTS:-}"
readonly SERVER_ARGS="$${K3S_SERVER_ARGS:-}"
readonly INSTALL_EXEC="server --node-name $${K3S_NODE_NAME}$(join_csv "$${NODE_LABELS}" "--node-label")$(join_csv "$${NODE_TAINTS}" "--node-taint") $${SERVER_ARGS}"

curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC="$${INSTALL_EXEC}" K3S_TOKEN="$${K3S_TOKEN}" sh -
SCRIPT

chmod +x /usr/local/bin/bootstrap-k3s-server.sh

if [[ -n '${k3s_token}' ]]; then
  K3S_TOKEN='${k3s_token}' \
  K3S_NODE_NAME='${k3s_node_name}' \
  K3S_NODE_LABELS='${k3s_node_labels}' \
  K3S_NODE_TAINTS='${k3s_node_taints}' \
  K3S_SERVER_ARGS='${k3s_server_args}' \
  /usr/local/bin/bootstrap-k3s-server.sh
fi
