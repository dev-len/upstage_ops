inputs = {
  aws_region  = "us-east-1"
  name_prefix = "k3s-dev"
  vpc_id      = "vpc-xxxxxxxxxxxxxxxxx"
  admin_cidr  = "203.0.113.10/32"
  bastion_ssh_port = 22022
  primary_az  = "us-east-1a"
  ami_id      = "ami-xxxxxxxxxxxxxxxxx"
  key_name    = "k3s-dev-key"

  # Set both values to reuse pre-created security groups and skip SG creation.
  # existing_server_security_group_id        = "sg-xxxxxxxxxxxxxxxxx"
  # existing_worker_shared_security_group_id = "sg-xxxxxxxxxxxxxxxxx"
  # existing_bastion_security_group_id       = "sg-xxxxxxxxxxxxxxxxx"
  manage_existing_bastion_ssh_ingress_rules = true

  bootstrap_bastion_helpers = true
  # Set this to enable first-boot K3S automation. Existing running instances
  # will not re-run user_data automatically; recreate them if you need to apply
  # the new bootstrap path to already-created nodes.
  # k3s_bootstrap_token = "replace-me-with-a-shared-token"

  subnet_ids_by_az = {
    us-east-1a = "subnet-xxxxxxxx"
    us-east-1b = "subnet-xxxxxxxx"
    us-east-1c = "subnet-xxxxxxxx"
    us-east-1d = "subnet-xxxxxxxx"
    us-east-1e = "subnet-xxxxxxxx"
    us-east-1f = "subnet-xxxxxxxx"
  }

  instance_type               = "t3.medium"
  associate_public_ip_address = false
  enable_bastion             = true
  bastion_instance_type      = "t3.micro"
  bastion_associate_public_ip_address = true
  enable_storage              = false
  root_volume_size_gb         = 16
  root_volume_type            = "gp3"

  # When enable_storage is false in the training account, grow the root disk
  # for stateful roles instead of provisioning separate EBS volumes.
  db_root_volume_size_gb         = 40
  llm_obs_root_volume_size_gb    = 40
  clickhouse_root_volume_size_gb = 100

  db_volume_size_gb         = 40
  db_volume_type            = "gp3"
  db_device_name            = "/dev/sdf"
  llm_obs_volume_size_gb    = 40
  llm_obs_volume_type       = "gp3"
  llm_obs_device_name       = "/dev/sdg"
  clickhouse_volume_size_gb = 100
  clickhouse_volume_type    = "gp3"
  clickhouse_device_name    = "/dev/sdh"
}
